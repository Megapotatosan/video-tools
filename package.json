{
  "name": "video-tools",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "copy:ffmpeg": "node -e \"const fs=require('fs');const src='node_modules/@ffmpeg/core/dist/esm';fs.copyFileSync(src+'/ffmpeg-core.js','public/ffmpeg/ffmpeg-core.js');fs.copyFileSync(src+'/ffmpeg-core.wasm','public/ffmpeg/ffmpeg-core.wasm');console.log('FFmpeg assets copied.')\"",
    "build": "npm run copy:ffmpeg && next build",
    "start": "serve out",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediabunny/mp3-encoder": "^1.21.1",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.44.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "serve": "^14.2.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
